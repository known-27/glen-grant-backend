# ============================================================
# THE GLEN GRANT — BARTENDER NOTES
# Environment Variables — Example Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit .env to version control.

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── MongoDB Atlas ────────────────────────────────────────────
# Full connection string from MongoDB Atlas dashboard
# Example: mongodb+srv://user:password@cluster.mongodb.net/glen-grant?retryWrites=true&w=majority
MONGODB_URI=

# ── Cloudinary ───────────────────────────────────────────────
# Get these from your Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin Panel Credentials ──────────────────────────────────
# Used to protect the /admin web interface
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_use_strong_password

# ── Session Secret ───────────────────────────────────────────
# A long random string used to sign sessions — keep this secret
SESSION_SECRET=replace_with_long_random_secret_string_here

# ── Event Configuration ──────────────────────────────────────
# IANA timezone string for date-based count queries
EVENT_TIMEZONE=Asia/Kolkata

# Default event ID used when Android devices do not pass one
EVENT_ID=glen-grant-event-2024

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Example: https://yourdomain.com,https://admin.yourdomain.com
# Use * during development only
CORS_ORIGIN=*

# ── Environment ──────────────────────────────────────────────
NODE_ENV=development
